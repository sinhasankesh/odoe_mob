EXPO_PUBLIC_API_URL=http://localhost:5001

# Use your computer LAN address or deployed HTTPS hosts for physical devices.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Web client ID used by Google AuthSession and accepted by the backend verifier.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=133570863314-ma84sqlqdmnqbqt49dh946k8euvlfnvr.apps.googleusercontent.com
# Native OAuth IDs must match the app's bundle ID and Android package/signing keys.
# Ask the backend to allow these IDs as valid ID-token audiences too; see notes below.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# In the backend, verifyIdToken currently accepts only GOOGLE_CLIENT_ID. To support
# native ID tokens, set GOOGLE_CLIENT_IDS to a comma-separated list of all three IDs
# and verify with audience: process.env.GOOGLE_CLIENT_IDS.split(',').map(id => id.trim()).

# The web app's Google OAuth flow must redirect to odoe://auth/callback?token=<API token>.
# Configure its OAuth callback and deep-link allow-list on the server as well.
