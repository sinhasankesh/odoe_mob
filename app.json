{
  "expo": {
    "name": "Odoe",
    "slug": "odoe-mobile",
    "scheme": "odoe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.odoe.mobile" },
    "android": { "package": "com.odoe.mobile", "edgeToEdgeEnabled": true }
  }
}
